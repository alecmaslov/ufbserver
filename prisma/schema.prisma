generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Client {
  id               String             @id @default(cuid())
  userId           String?
  platform         Platform           @default(WEB)
  createdAt        DateTime           @default(now())
  user             User?              @relation(fields: [userId], references: [id])
  ConnectedBrowser ConnectedBrowser[]
  gameSession      GameSession[]
  player           Player[]

  @@index([userId], map: "Client_userId_fkey")
  @@map("client")
}

model User {
  id              String      @id @default(cuid())
  displayName     String
  gold            Int         @default(0)
  crystals        Int         @default(0)
  email           String      @unique
  profileImageUrl String?
  passwordHash    String?
  createdAt       DateTime    @default(now())
  client          Client[]
  character       Character[]

  // opposite relation field (back-reference)
  userData      UserData? // 1:1
  characterData CharacterData[]
  figurines     Figurine[]

  @@map("user")
}

model UserData {
  id             String @id @default(cuid())
  gold           Int    @default(0)
  losses         Int    @default(0)
  wins           Int    @default(0)
  kills          Int    @default(0)
  battles        Int    @default(0)
  damage_taken   Int    @default(0)
  item_bags      Int    @default(0)
  used_energies  Int    @default(0) // fixed typo: energe -> energy
  damage_deal    Int    @default(0)
  used_stacks    Int    @default(0)
  damage_heal    Int    @default(0)
  collect_golds  Int    @default(0)
  traveled_tiles Int    @default(0)
  chests         Int    @default(0)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_data")
}

model GameSession {
  id               String             @id @default(cuid())
  createdAt        DateTime           @default(now())
  hostClientId     String
  hostClient       Client             @relation(fields: [hostClientId], references: [id])
  gameSessionState GameSessionState[]
  player           Player[]

  @@index([hostClientId], map: "GameSession_hostClientId_fkey")
  @@map("gamesession")
}

model Player {
  id              String            @id @default(cuid())
  clientId        String
  gameSessionId   String
  lastSeen        DateTime          @default(now())
  client          Client            @relation(fields: [clientId], references: [id])
  gameSession     GameSession       @relation(fields: [gameSessionId], references: [id])
  playerGameState PlayerGameState[]

  @@index([clientId], map: "Player_clientId_fkey")
  @@index([gameSessionId], map: "Player_gameSessionId_fkey")
  @@map("player")
}

model PlayerGameState {
  id       String @id @default(cuid())
  playerId String
  energy   Int
  health   Int
  player   Player @relation(fields: [playerId], references: [id])

  @@index([playerId], map: "PlayerGameState_playerId_fkey")
  @@map("playergamestate")
}

model GameSessionState {
  id            String      @id @default(cuid())
  gameSessionId String
  gameSession   GameSession @relation(fields: [gameSessionId], references: [id])

  @@index([gameSessionId], map: "GameSessionState_gameSessionId_fkey")
  @@map("gamesessionstate")
}

/// The one saved solo game a player can resume (guest "web-…" id or account id). A snapshot of the room state.
model SoloSave {
  ownerId     String   @id
  mapName     String
  heroClass   String
  displayName String
  turn        Int
  state       Bytes    @db.MediumBlob
  extra       String   @db.Text
  updatedAt   DateTime @updatedAt

  @@map("solo_save")
}

model Asset {
  objectKey   String        @id
  bucketName  String
  region      String
  bundleAsset BundleAsset[]

  @@map("asset")
}

model BundleAsset {
  id      String @id @default(cuid())
  version String
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [objectKey])

  @@index([assetId], map: "BundleAsset_assetId_fkey")
  @@map("bundleasset")
}

model UfbMap {
  id              String  @id @default(cuid())
  name            String
  thumbnailUrl    String?
  description     String?
  gridWidth       Int
  gridHeight      Int
  publisher       String?
  resourceAddress String?
  isPublished     Boolean @default(false)
  tiles           Tile[]

  @@map("ufbmap")
}

model Tile {
  id                  String          @id @default(cuid())
  tileCode            String
  mapId               String
  x                   Int
  y                   Int
  legacyCode          String?
  type                TileType        @default(OpenTile)
  walls               Json?
  spawnZone           SpawnZone?
  map                 UfbMap          @relation(fields: [mapId], references: [id], onDelete: Cascade)
  fromTileAdjacencies TileAdjacency[] @relation("FromAdjacency")
  tileAdjacencies     TileAdjacency[]
  toTileAdjacencies   TileAdjacency[] @relation("ToAdjacency")

  // @@unique([tileCode, mapId])
  // @@unique([x, y, mapId])
  @@index([mapId], map: "Tile_mapId_fkey")
  @@map("tile")
}

model SpawnZone {
  id     String        @id @default(cuid())
  type   SpawnZoneType
  seedId Int
  tileId String        @unique
  tile   Tile          @relation(fields: [tileId], references: [id], onDelete: Cascade)

  @@map("spawnzone")
}

model TileAdjacency {
  id         String        @id @default(cuid())
  fromId     String
  toId       String
  type       AdjacencyType
  energyCost Int?
  tileId     String?
  from       Tile          @relation("FromAdjacency", fields: [fromId], references: [id], onDelete: Cascade)
  tile       Tile?         @relation(fields: [tileId], references: [id], onDelete: Cascade)
  to         Tile          @relation("ToAdjacency", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@index([tileId], map: "TileAdjacency_tileId_fkey")
  @@index([toId], map: "TileAdjacency_toId_fkey")
  @@map("tileadjacency")
}

model ConnectedBrowser {
  ipAddress      String    @id
  clientId       String
  connectedAt    DateTime  @default(now())
  disconnectedAt DateTime?
  client         Client    @relation(fields: [clientId], references: [id])

  @@index([clientId], map: "ConnectedBrowser_clientId_fkey")
  @@map("connectedbrowser")
}

model CharacterClass {
  name           String       @id
  description    String?
  avatarUrl      String?
  cardUrl        String?
  sketchfabUrl   String?
  ultimateMove   String       @default("None")
  characterToken Character[]
  godLevelNft    GodLevelNft?

  @@map("character_class")
}

model Character {
  id             String         @id @default(cuid())
  name           String
  traits         Json?
  ownerId        String?
  nftId          String?        @unique
  level          Int            @default(1)
  className      String
  characterClass CharacterClass @relation(fields: [className], references: [name])
  nft            Nft?           @relation(fields: [nftId], references: [id])
  owner          User?          @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  characterData CharacterData[]
  skills        CharacterSkill[]
  figurine      Figurine?

  /// the three elements rolled when this figurine was bought, in slot order; permanent
  elements  Json?
  keystones Json?

  @@index([className], map: "character_token_className_fkey")
  @@index([ownerId], map: "character_token_ownerId_fkey")
  @@map("character_token")
}

////
model CharacterTest {
  id          String  @id @default(cuid())
  name        String  @unique
  traits      Json?
  ownerId     String?
  nftId       String? @unique
  className   String
  maxEnergy   String
  energy      String
  maxHealth   String
  health      String
  ultimate    String
  maxUltimate String
  gold        String
  melee       String
  maxMelee    String
  mana        String
  maxMana     String

  @@index([className], map: "character_token_className_fkey")
  @@index([ownerId], map: "character_token_ownerId_fkey")
  @@map("charactertest")
}

model CharacterData {
  id             String @id @default(cuid())
  gold           Int    @default(0)
  losses         Int    @default(0)
  wins           Int    @default(0)
  kills          Int    @default(0)
  battles        Int    @default(0)
  damage_taken   Int    @default(0)
  item_bags      Int    @default(0)
  used_energies  Int    @default(0) // fixed typo: energe -> energy
  damage_deal    Int    @default(0)
  used_stacks    Int    @default(0)
  damage_heal    Int    @default(0)
  collect_golds  Int    @default(0)
  traveled_tiles Int    @default(0)
  chests         Int    @default(0)

  maxEnergy   Int @default(0)
  energy      Int @default(0)
  maxHealth   Int @default(0)
  health      Int @default(0)
  ultimate    Int @default(0)
  maxUltimate Int @default(0)
  maxMelee    Int @default(0)
  maxMana     Int @default(0)

  userId      String
  characterId String

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId]) // One per character per user
  @@map("character_data")
}

model Nft {
  id                 String       @id @default(cuid())
  tokenId            String
  contractAddress    String
  tokenUri           String
  tokenHolderAddress String
  tokenHolderName    String?
  name               String
  tokenHolderUrl     String?
  character          Character?
  godLevelNft        GodLevelNft?
  contract           NftContract  @relation(fields: [contractAddress], references: [address], onDelete: Cascade)

  @@unique([contractAddress, tokenId])
  @@map("nft")
}

model NftContract {
  address          String  @id
  name             String
  symbol           String
  totalSupply      Int
  tokenType        String
  contractDeployer String
  imageUrl         String?
  description      String?
  externalUrl      String?
  twitterUsername  String?
  discordUrl       String?
  bannerImageUrl   String?
  chainId          String  @default("ethereum")
  slug             String?
  nfts             Nft[]

  @@map("nft_contract")
}

model GodLevelNft {
  characterClassName String         @unique
  nftId              String         @unique
  isPublished        Boolean        @default(false)
  characterClass     CharacterClass @relation(fields: [characterClassName], references: [name], onDelete: Cascade)
  nft                Nft            @relation(fields: [nftId], references: [id], onDelete: Cascade)

  @@map("god_level_nft")
}

model Item {
  id          String  @id @default(cuid())
  name        String
  category    String
  description String?
  nftId       String? @unique

  @@map("item")
}

model ItemBehavior {
  id String @id @default(cuid())

  @@map("itembehavior")
}

enum Platform {
  WEB
  ANDROID
  IOS
  STEAM
  UNITY_EDITOR
}

enum TileType {
  VerticalBridge
  HorizontalBridge
  DoubleBridge
  Void
  StairsNS
  StairsSN
  StairsEW
  StairsWE
  Upper
  Lower
  OpenTile
  BlockNorth
  BlockEast
  BlockSouth
  BlockWest
  BlockNS
  BlockEW
  BlockNE
  BlockES
  BlockSW
  BlockNW
  BlockESW
  BlockSWN
  BlockWNE
  BlockNES
}

enum SpawnZoneType {
  Merchant
  Portal
  Monster
  Chest
}

enum AdjacencyType {
  Basic
  OverBridge
  UnderBridge
  Wall
  Void
}

/// One purchased skill-tree node. Append-only: the ledger is the character's progress, an audit
/// trail for every gold sink, and the per-node data we need to tune the trees later.
model CharacterSkill {
  id          String   @id @default(cuid())
  characterId String
  element     String
  slot        Int
  nodeIndex   Int
  cost        Int
  purchasedAt DateTime @default(now())

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, slot, nodeIndex])
  @@index([characterId])
  @@map("character_skill")
}

/// A physical figurine: the thing a player actually buys, with an NFC chip in it.
///
/// This is the paywall. A hero is not bought with gold — it is claimed by proving you hold the
/// figurine, either by tapping its chip or by entering the code that shipped in the box. The
/// claim code is only ever stored hashed, because a readable code is free inventory.
///
/// Progress belongs to the figurine, not the account: the Character and its skill tree hang off
/// this row, so releasing a figurine and re-claiming it on another account carries the tree with
/// it. That matches how a physical toy behaves when it is resold.
model Figurine {
  id          String    @id // serial, printed on the box
  className   String // which hero this figurine is
  claimHash   String    @unique // sha256 of the claim code; the code is never stored
  nfcUid      String?   @unique // the chip's own id, recorded the first time it is tapped
  ownerId     String? // the account holding it now, if any
  characterId String?   @unique // the character it carries, created on first claim
  claimedAt   DateTime?
  createdAt   DateTime  @default(now())

  // inventory (admin): where the physical toy is. Claiming doesn't change it — a sold figurine is
  // claimed by whoever holds it, which may not be the buyer.
  status    String   @default("in_stock") // in_stock | reserved | sold | shipped | returned | lost | retired
  batch     String? // production run / label, e.g. "2026-10 first run"
  notes     String?  @db.Text
  saleId    String?
  updatedAt DateTime @default(now()) @updatedAt

  owner     User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  character Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  sale      Sale?      @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([saleId])
  @@index([status])
  @@map("figurine")
}

/// A sale of one or more figurines. Entered by hand in the admin today; a store webhook will create
/// these later (channel = the store, orderRef = its order number, unique per channel).
model Sale {
  id         String     @id @default(cuid())
  channel    String     @default("manual")
  orderRef   String?
  buyerName  String?
  buyerEmail String?
  shipTo     String?    @db.Text
  totalCents Int?
  currency   String     @default("USD")
  soldAt     DateTime   @default(now())
  shippedAt  DateTime?
  notes      String?    @db.Text
  createdAt  DateTime   @default(now())
  figurines  Figurine[]

  @@unique([channel, orderRef])
  @@index([soldAt])
  @@map("sale")
}

/// One match, written by UfbRoom as it starts and finishes (admin → game stats).
model MatchRecord {
  id        String        @id @default(cuid())
  roomId    String
  mode      String // solo | party
  mapName   String
  startedAt DateTime      @default(now())
  endedAt   DateTime?
  endReason String? // victory | defeat | abandoned
  turns     Int           @default(0)
  rounds    Int           @default(0)
  humans    Int           @default(0)
  players   MatchPlayer[]

  @@index([startedAt])
  @@map("match_record")
}

/// One hero in a match. playerId is the account id, or a guest's "web-…" id.
model MatchPlayer {
  id           String      @id @default(cuid())
  matchId      String
  playerId     String
  isGuest      Boolean     @default(true)
  heroClass    String
  heroLevel    Int         @default(1)
  lang         String? // language of the page the player joined from
  place        Int?
  result       String? // win | died | quit | unfinished
  diedTurn     Int?
  killedBy     String?
  damageDealt  Int         @default(0)
  damageTaken  Int         @default(0)
  healed       Int         @default(0)
  tilesMoved   Int         @default(0)
  energyUsed   Int         @default(0)
  stacksUsed   Int         @default(0)
  playerKills  Int         @default(0)
  monsterKills Int         @default(0)
  goldEarned   Int         @default(0)
  turnsPlayed  Int         @default(0)
  moves        Json? // { "Sword Strike": 3, … }
  items        Json? // items used { "Potion": 1 }
  equipped     Json? // power names equipped when the match ended for them
  joinedAt     DateTime    @default(now())
  endedAt      DateTime?
  match        MatchRecord @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
  @@index([heroClass])
  @@index([playerId])
  @@map("match_player")
}

/// Language menu events (client/src/lang.ts). No IP or account is stored; vid is a random browser id.
model LangEvent {
  id        BigInt   @id @default(autoincrement())
  type      String // switch | view
  vid       String   @db.VarChar(64)
  lang      String   @db.VarChar(8) // language of the page it was sent from
  fromLang  String?  @db.VarChar(8)
  toLang    String?  @db.VarChar(8)
  source    String?  @db.VarChar(16) // menu | offer
  path      String   @db.VarChar(191)
  browser   String?  @db.VarChar(32) // navigator.language
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([createdAt])
  @@map("lang_event")
}

/// How often each tile of a map has been stood on, across every match ever played on it.
///
/// The recording half of "the Easter Egg": the rarely-trodden tiles are the ones that will one day
/// carry a small chance of triggering it. Recorded from the day this shipped even though nothing
/// reads it yet, because the history is the part that cannot be backfilled — a heatmap is noise
/// until there is real traffic through it, and it only accumulates if you start.
///
/// Keyed by map NAME rather than UfbMap.id: that is what the room is created with
/// (createOptions.mapName) and what MatchRecord already stores, so the two line up without a lookup.
///
/// What is deliberately NOT counted (Alec, 2026-10-06), because each would corrupt the signal:
///   - solo games entirely — one player with no witnesses is where the heatmap would be easiest to
///     shape on purpose; party games cost other people's time to manipulate (gated in MatchStats);
///   - monster movement — they roam the whole board every turn now, which would drown out where
///     players choose to walk;
///   - every spawn-zone tile: merchants, chests/loot, portals and monster spawns. The map creates
///     traffic to those, so they could never rank as rare, and they are already rewards in their
///     own right;
///   - bridges, stairs and void — crossings, not places to stand;
///   - the tile a move starts from, which is already counted by the move that ended there.
model TileStep {
  mapName   String   @db.VarChar(64)
  tileId    String   @db.VarChar(64)
  steps     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([mapName, tileId])
  /// The lookup the trigger will want: the least-trodden tiles of one map.
  @@index([mapName, steps])
  @@map("tile_step")
}
